# OGHOST PANEL - panel configuration (copy to .env; installer/install.sh generates this for you)
# Payment gateways, SMTP, Firebase, Google OAuth/Drive and security options are NOT set here:
# configure them in Admin -> Settings (stored in the database, secrets encrypted with APP_KEY).

NODE_ENV=production
# Public URL customers use (https strongly recommended; enables Secure cookies)
APP_URL=https://panel.example.com
HOST=127.0.0.1
PORT=8080
# 32+ random bytes. Generate with: node dist/panel.mjs keygen   (never change after setup: encrypted secrets depend on it)
APP_KEY=
# Express trust proxy setting: loopback when behind nginx/Caddy on the same host
TRUST_PROXY=loopback
SESSION_TTL_HOURS=72

DB_HOST=78.46.164.171
DB_PORT=3306
DB_NAME=db_774499
DB_USER=db_774499
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Optional unix socket instead of host/port
DB_SOCKET=

# Hidden data folder (.server/{nodes,backups,temporary,metadata})
DATA_ROOT=./.server
# Optional overrides
FRONTEND_DIR=
EXTENSIONS_DIR=
UPLOADS_DIR=
MIGRATIONS_DIR=
# Seconds without heartbeat before a node is marked offline
NODE_OFFLINE_SECONDS=60

# CA bundle to trust when nodes use self-signed TLS (exported as NODE_EXTRA_CA_CERTS by scripts/run.sh)
NODE_CA_FILE=

# 1 = write emails to the log instead of sending them (development only)
MAIL_LOG_ONLY=0

# OGCoins integrations. These can also be set in Admin -> Settings (database values win). See documentation/COINS.md
#LINKVERTISE_TOKEN=
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
# Endpoints - only change for testing against tests/mocks/coins-mock.mjs
#LINKVERTISE_API_BASE=https://publisher.linkvertise.com
#LINKVERTISE_LINK_BASE=https://link-to.net
#DISCORD_API_BASE=https://discord.com

# Google endpoints - only change for testing against tests/mocks/google-mock.mjs
GOOGLE_OAUTH_BASE=https://oauth2.googleapis.com
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
